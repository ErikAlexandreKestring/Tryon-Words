{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/sync-category-keywords.sh",
            "timeout": 30,
            "statusMessage": "Sincronizando category-keywords.json com S3..."
          }
        ]
      }
    ]
  }
}
